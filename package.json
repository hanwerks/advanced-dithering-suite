{
  "name": "advanced-dithering-suite",
  "version": "0.1.0",
  "description": "Professional image dithering tool with advanced algorithms and noise integration",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "extract": "node scripts/extract-components.js",
    "docs": "jsdoc src -r -d docs",
    "analyze": "vite-bundle-analyzer"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use": "^17.4.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/ui": "^3.2.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdoc": "^4.0.2",
    "prettier": "^3.0.0",
    "vite": "^6.3.5",
    "vite-bundle-analyzer": "^0.7.0",
    "vitest": "^3.2.3"
  },
  "keywords": [
    "image-processing",
    "dithering",
    "noise-algorithms",
    "web-app",
    "react",
    "vite"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/advanced-dithering-suite"
  }
}

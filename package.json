{
  "name": "advanced-dithering-suite",
  "version": "1.0.0",
  "description": "Professional image dithering and processing toolkit",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:component": "vite --config vite.component.config.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:component": "vitest --config vitest.component.config.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "setup:branches": "node scripts/setup-branches.js",
    "create:component": "node scripts/create-component.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0",
    "vitest": "^0.34.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0"
  }
}
